# Required for production EDGAR access. Use a monitored, non-placeholder email
# so the SEC can identify and contact the application operator when necessary.
SEC_USER_AGENT=""
SEC_FETCH_TIMEOUT_MS="20000"
SEC_FETCH_MAX_ATTEMPTS="3"
SEC_FETCH_RETRY_BASE_DELAY_MS="300"
SEC_FETCH_RETRY_MAX_DELAY_MS="5000"
SEC_TICKER_DIRECTORY_TIMEOUT_MS="15000"

# Optional SEC bulk archive cache. If these configured ZIP paths are absent,
# the server starts a background download into tmp/sec-bulk and uses live SEC
# APIs until the cache is ready.
SEC_BULK_CACHE_DIR="tmp/sec-bulk"
SEC_BULK_COMPANYFACTS_ZIP=""
SEC_BULK_SUBMISSIONS_ZIP=""
SEC_BULK_REFRESH_INTERVAL_MS="86400000"
SEC_ARCHIVE_FETCH_TIMEOUT_MS="20000"
SEC_FILING_RESPONSE_CACHE_MAX_ENTRIES="128"
SEC_FILING_PACKAGE_CACHE_MAX_ENTRIES="32"
SEC_FILING_CACHE_TTL_MS="1800000"

# Optional analyst-facing API protection and upload/runtime guards. Analysts enter
# HISTORICALS_API_KEY in the page's deployment-access-key field; the server secret
# is never embedded in the browser bundle or workbook.
HISTORICALS_API_KEY=""
# Production fails closed when HISTORICALS_API_KEY is absent. Set this only for
# an isolated trusted deployment where unauthenticated uploads are intentional.
ALLOW_UNAUTHENTICATED_FILL="false"
# Optional client-side override used by scripts/fill-workbook-api.js when the
# regression harness calls a protected remote deployment.
FILL_API_KEY=""
FILL_MODEL_MAX_UPLOAD_BYTES="31457280"
FILL_MODEL_MAX_MULTIPART_OVERHEAD_BYTES="1048576"
FILL_MODEL_UPLOAD_READ_TIMEOUT_MS="120000"
FILL_MODEL_MAX_CONCURRENT_REQUESTS="1"
# Defaults to the operating-system temporary directory. For multiple workers on
# one host, point every worker at the same writable lock path. Multi-host
# deployments need a shared filesystem path or an external distributed lock.
FILL_MODEL_PROCESS_LOCK_PATH=""
FILL_MODEL_PROCESS_LOCK_STALE_MS="960000"
FILL_MODEL_MAX_XLSX_ENTRIES="20000"
FILL_MODEL_MAX_XLSX_UNCOMPRESSED_BYTES="268435456"
FILL_MODEL_MAX_XLSX_ENTRY_BYTES="67108864"

# Optional user-verified completed-model library.
# Workbooks with "filled" in the filename are always excluded from gold-model use.
GOLD_MODEL_LIBRARY_PATH=""
GOLD_MODEL_MANIFEST_PATH=""
GOLD_MODEL_VERIFIED_PATHS=""

# LLM-led accounting mapping. When enabled, every consolidated primary income
# statement and balance-sheet row is reviewed before workbook values are written.
OPENROUTER_API_KEY=""
LLM_MAPPING_ENABLED="true"
LLM_ANALYST_MODE="true"
# The LLM is the responsible analyst, not a fallback around the mapper.
LLM_MAPPING_FAST_MODEL="openai/gpt-5.6-sol-pro"
LLM_MAPPING_COMPLEX_MODEL="openai/gpt-5.6-sol-pro"
LLM_MAPPING_REVIEW_MODEL="openai/gpt-5.6-sol-pro"
LLM_MAPPING_FAST_FALLBACK_MODELS="anthropic/claude-sonnet-5"
LLM_MAPPING_COMPLEX_FALLBACK_MODELS="anthropic/claude-sonnet-5"
LLM_MAPPING_REVIEW_FALLBACK_MODELS="anthropic/claude-sonnet-5"
LLM_MAPPING_MAX_CALLS="48"
LLM_MAPPING_HARD_MAX_CALLS="64"
LLM_MAPPING_REVIEW_RESERVED_CALLS="6"
LLM_MAPPING_REVIEW_RESERVED_MS="300000"
LLM_LINE_ITEM_CLASSIFICATION_MAX_CALLS="48"
LLM_FULL_STATEMENT_COVERAGE="true"
LLM_REQUIRE_FULL_STATEMENT_COVERAGE="true"
LLM_TOTAL_TIMEOUT_MS="780000"
LLM_MAPPING_TIMEOUT_MS="10000"
LLM_LINE_ITEM_CLASSIFICATION_TIMEOUT_MS="90000"
LLM_MAPPING_REVIEW_TIMEOUT_MS="240000"
LLM_MAPPING_REVIEW_ENABLED="true"
LLM_MAPPING_REVIEW_MAX_ITEMS="1200"
LLM_MAPPING_RECOVERY_MAX_ITEMS="220"
LLM_MAPPING_REVIEW_BLOCKING="true"
LLM_MAPPING_REVIEW_AUTOCORRECT="true"
LLM_MAPPING_MIN_CANDIDATE_SCORE="2"
LLM_MAPPING_CANDIDATE_LIMIT="80"
LLM_WORKBENCH_MAX_FACTS="500"
LLM_WORKBENCH_MAX_STATEMENT_ROWS="650"
LLM_WORKBENCH_MAX_WORKBOOK_CELLS="700"
LLM_WORKBENCH_MAX_AUDIT_ROWS="500"
LLM_WORKBENCH_MAX_SOURCE_LEDGER_ROWS="600"
LLM_WORKBENCH_MAX_BALANCE_ASSIGNMENTS="500"
OPENROUTER_APP_TITLE="Historicals Solver"
OPENROUTER_MODEL_CAPABILITY_CACHE_TTL_MS="900000"
OPENROUTER_MODEL_CAPABILITY_FAILURE_CACHE_TTL_MS="10000"

# Regression harness fixtures. Prefer a real gold_models.json in local env; the
# example manifest is only a shape/reference for setting up verified gold models.
GOLD_MODEL_LIBRARY_PATH=""
GOLD_MODEL_MANIFEST_PATH=""
GOLD_MODEL_VERIFIED_PATHS=""
REGRESSION_STANDARD_TEMPLATE=""
REGRESSION_FINANCIAL_TEMPLATE=""
REGRESSION_BASKET_CONFIG=""
REGRESSION_BASKET_CASES="AAPL,GOOG,NVDA,KO,PANW,LLY,INTC,MCD,PEP,CPB,IBM,RSG,DE,JEF"
REGRESSION_RESULTS_FILE=""
REGRESSION_BASELINE_OUT=""
REGRESSION_COMPARE_BASELINE=""
REGRESSION_ALLOW_MISSING_INPUTS="false"
REGRESSION_SEC_FETCH_TIMEOUT_MS="60000"
OPENROUTER_SITE_URL="http://localhost:3000"
